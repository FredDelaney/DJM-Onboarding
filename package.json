{
  "name": "djm-player",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "sanitize:text": "node scripts/sanitize-user-facing-text.mjs",
    "predev": "npm run check:no-em-dash",
    "dev": "next dev",
    "prebuild": "npm run check:no-em-dash",
    "build": "next build",
    "start": "next start",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "precheck": "npm run check:no-em-dash",
    "check": "npm test && npm run typecheck && npm run build",
    "check:no-em-dash": "node scripts/check-no-em-dash.mjs"
  },
  "dependencies": {
    "@react-pdf/renderer": "4.5.1",
    "@supabase/supabase-js": "2.112.4",
    "lucide-react": "^0.468.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5"
  }
}
